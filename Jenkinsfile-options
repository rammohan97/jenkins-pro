pipeline {
    agent {
        node { label 'agent-1' }
    }
    environment {
        NAME = 'Ram'
    }
    options {
        timeout (time: 10, unit: 'SECONDS')
    }
    stages {
        stage ('Build') {
            steps {
                script {
                    sh """
                     echo 'Building...'
                     echo "Hello ${NAME}"
                     sleep 10;
                     env
                    """
                }
            }
        }
        stage ('Test') {
            steps {
                echo 'Testing...'
            }
        }
        stage ('Deploy') {
            steps {
                echo 'Deploying...'
            }
        }
    }
    post {
        always {
            echo ' Always executed'
            cleanWs()
        }
        success {
            echo ' Success executed'
        }
        failure {
            echo ' Failure executed'
        }
        aborted {
            echo ' Aborted executed'
        }
    }
}